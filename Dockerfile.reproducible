FROM rust:1.93.1-bookworm@sha256:7c4ae649a84014c467d79319bbf17ce2632ae8b8be123ac2fb2ea5be46823f31

ARG STELLAR_CLI_VERSION=27.1.0
ENV CARGO_TERM_COLOR=never \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    SOURCE_DATE_EPOCH=0 \
    TZ=UTC

RUN rustup target add wasm32v1-none \
    && cargo install --locked stellar-cli --version "${STELLAR_CLI_VERSION}"

WORKDIR /workspace
ENTRYPOINT ["bash", "scripts/build-reproducible.sh"]
