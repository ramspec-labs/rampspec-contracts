{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rampspec.org/schemas/pubnet-decision-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "decision", "scope", "currentClaim", "maximumClaimUntilReview",
    "fixturesAllowed", "pubnetManifest", "deploymentTransaction", "decidedAt",
    "nextReviewAfter", "gates", "reasons"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "decision": { "enum": ["no-deploy", "deploy"] },
    "scope": { "const": "evidence-registry" },
    "currentClaim": { "enum": ["local-verification-only", "testnet-only", "pubnet"] },
    "maximumClaimUntilReview": { "enum": ["testnet-only", "pubnet"] },
    "fixturesAllowed": { "type": "boolean" },
    "pubnetManifest": { "type": ["string", "null"] },
    "deploymentTransaction": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] },
    "decidedAt": { "type": "string", "format": "date-time" },
    "nextReviewAfter": { "type": "string", "format": "date-time" },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": [
        "interoperabilityNeed", "securityReview", "remediation", "signedRelease",
        "adminCustody", "attestorCustody", "ttlCostBudget", "monitoring", "incidentAndUpgradePolicy"
      ],
      "properties": {
        "interoperabilityNeed": { "type": "string", "minLength": 1 },
        "securityReview": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "signedRelease": { "type": "string", "minLength": 1 },
        "adminCustody": { "type": "string", "minLength": 1 },
        "attestorCustody": { "type": "string", "minLength": 1 },
        "ttlCostBudget": { "type": "string", "minLength": 1 },
        "monitoring": { "type": "string", "minLength": 1 },
        "incidentAndUpgradePolicy": { "type": "string", "minLength": 1 }
      }
    },
    "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
